# --- GCP CONFIGURATION ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
# Path inside the container if mounting, or local path for dev
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# --- BILLING CONFIGURATION ---
# BigQuery dataset for billing export
GCP_BILLING_DATASET=billing_export
# BigQuery table pattern (e.g., gcp_billing_export_v1_*)
GCP_BILLING_TABLE=gcp_billing_export_v1_*

# --- FRONTEND CONFIGURATION ---
# Base URL for the backend API
VITE_API_BASE_URL=http://localhost:8000/api
